#!/usr/bin/env bash
# Pick a snippet with fzf and print it to stdout. Meant to be run via terminal-picker.sh.
set -euo pipefail

/opt/homebrew/bin/rg -v '^#|^$' ~/.local/src/datagrip/snippets \
    | fzf --no-sort --reverse --prompt='snippet> ' \
          --delimiter=' #' --with-nth=1.. \
    | awk -F ' #' '{printf "%s", $1}'
