#!/bin/sh

# If transmission-daemon is running, will ask to kill, else will ask to start.

ask() { [ "$(printf "No\\nYes" | tofi-dmenu -p "$1 " -W 500 -H 160)" = "Yes" ]; }

if pidof transmission-daemon >/dev/null ;
then
	ask "Turn off transmission-daemon?" && killall transmission-daemon && notify-send "transmission-daemon disabled."
else
	ifinstalled transmission-cli || exit
	ask "Turn on transmission-daemon?" && transmission-daemon && notify-send "transmission-daemon enabled."
fi
