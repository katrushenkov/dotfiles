#!/bin/sh
# Generate bookmark shortcuts from ~/.config/shell/bm-dirs and bm-files:
#   ~/.config/shell/shortcutrc     shell aliases (dir: cd + yazi, file: $EDITOR)
#   ~/.config/shell/zshnameddirrc  zsh named dirs (~name)
#   ~/.local/share/bookmarks/      symlinks for the nvim ";g" shortcuts picker
#   ~/.config/yazi/bunny.lua       bunny.yazi hops (multi-char key = key sequence)
#
# Bookmark file format: "<key> <path>  # optional comment". The path may use
# $VAR, ${VAR} and ${VAR:-default}; only environment variables are expanded,
# nothing is executed.

set -eu

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
bmdirs="$cfg/shell/bm-dirs"
bmfiles="$cfg/shell/bm-files"
# Machine-local directory bookmarks (untracked), appended to bm-dirs.
bmdirs_local="${GIT_PROJECTS_DIR:-$HOME/.local/src}/datagrip/private/configs/bm-dirs.local"

shell_shortcuts="$cfg/shell/shortcutrc"
zsh_named_dirs="$cfg/shell/zshnameddirrc"
links_dir="${XDG_DATA_HOME:-$HOME/.local/share}/bookmarks"
yazi_bunny="$cfg/yazi/bunny.lua"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp" "$shell_shortcuts.tmp.$$" "$zsh_named_dirs.tmp.$$" "$yazi_bunny.tmp.$$"' EXIT

tab="$(printf '\t')"

# Strip comments and blank lines, expand environment variables in the path.
# Output: "<key>\t<path>" per line.
parse() {
	cat "$@" 2>/dev/null | awk '
		function expand(s,    out, m, i, def, val, start, len) {
			out = ""
			while (match(s, /\$(\{[A-Za-z_][A-Za-z0-9_]*(:-[^}]*)?\}|[A-Za-z_][A-Za-z0-9_]*)/)) {
				# save match position: the recursive expand() below resets RSTART/RLENGTH
				start = RSTART; len = RLENGTH
				m = substr(s, start + 1, len - 1)
				def = ""
				if (m ~ /^\{/) {
					m = substr(m, 2, length(m) - 2)
					if ((i = index(m, ":-")) > 0) { def = substr(m, i + 2); m = substr(m, 1, i - 1) }
				}
				val = (m in ENVIRON && ENVIRON[m] != "") ? ENVIRON[m] : expand(def)
				out = out substr(s, 1, start - 1) val
				s = substr(s, start + len)
			}
			return out s
		}
		{
			sub(/[ \t]*#.*/, "")
			if (!match($0, /^[ \t]*[^ \t]+[ \t]+/)) next
			key = $1
			path = substr($0, RLENGTH + 1)
			sub(/[ \t]+$/, "", path)
			if (path == "") next
			print key "\t" expand(path)
		}'
}

parse "$bmdirs" "$bmdirs_local" > "$tmp/dirs"
parse "$bmfiles" > "$tmp/files"

# Shell aliases, zsh named dirs and bunny.yazi hops.
awk -F '\t' \
	-v aliases="$shell_shortcuts.tmp.$$" \
	-v named="$zsh_named_dirs.tmp.$$" \
	-v bunny="$yazi_bunny.tmp.$$" '
	# Single-quote a string for the shell
	function q(s) { gsub(/'\''/, "'\''\\'\'''\''", s); return "'\''" s "'\''" }

	# Double-quoted Lua string literal
	function lua(s,    out, c, i) {
		out = ""
		for (i = 1; i <= length(s); i++) {
			c = substr(s, i, 1)
			out = out (c == "\\" || c == "\"" ? "\\" : "") c
		}
		return "\"" out "\""
	}

	# bunny key: "D" -> "D", "cfh" -> { "c", "f", "h" }
	function lua_key(k,    out, i) {
		if (length(k) == 1) return lua(k)
		out = "{"
		for (i = 1; i <= length(k); i++) out = out (i > 1 ? "," : "") " " lua(substr(k, i, 1))
		return out " }"
	}

	BEGIN {
		# $EDITOR is baked in at generation time (it may contain arguments)
		editor = ENVIRON["EDITOR"] != "" ? ENVIRON["EDITOR"] : "nvim"
		print "# vim: filetype=sh" > aliases
		print "# zsh named dirs" > named
		print "require(\"bunny\"):setup({\n  hops = {" > bunny
	}
	FILENAME ~ /dirs$/ {
		print "alias " $1 "=" q("cd " q($2) " && y") > aliases
		print "hash -d " $1 "=" q($2) > named
		printf "    { key = %-12s, path = %s, desc = %s },\n", lua_key($1), lua($2), lua($1) > bunny
	}
	FILENAME ~ /files$/ {
		print "alias " $1 "=" q(editor " " q($2)) > aliases
	}
	END {
		print "  },"                    > bunny
		print "  desc_strategy = \"path\"," > bunny
		print "  ephemeral = true,"     > bunny
		print "  tabs = true,"          > bunny
		print "  notify = false,"       > bunny
		print "  fuzzy_cmd = \"fzf\","  > bunny
		print "})"                      > bunny
	}
' "$tmp/dirs" "$tmp/files"
mv -f "$shell_shortcuts.tmp.$$" "$shell_shortcuts"
mv -f "$zsh_named_dirs.tmp.$$" "$zsh_named_dirs"
mv -f "$yazi_bunny.tmp.$$" "$yazi_bunny"

# Symlink bookmarks: the directory is fully generated, stale links are removed.
mkdir -p "$links_dir"
find "$links_dir" -mindepth 1 -maxdepth 1 -type l -delete
while IFS="$tab" read -r key path; do
	ln -sfn "$path/" "$links_dir/$key"
done < "$tmp/dirs"
