#!/bin/bash

# Merge upstream Omarchy (basecamp/omarchy, branch quattro) into the fork's
# master and push it to origin. Runs from omarchy-upstream-sync.timer.
#
# Conflicts are left in place for manual resolution; later runs skip until the
# merge is committed or aborted.

set -uo pipefail

REPO="$HOME/.local/src/omarchy"
BRANCH="master"
UPSTREAM_REF="upstream/quattro"
APP="Omarchy upstream sync"

notify() {
  local urgency=$1 headline=$2 body=${3:-}
  shift 3
  echo "$headline: $body"
  omarchy-notification-send --app-name "$APP" -u "$urgency" "$headline" "$body" "$@" || true
}

open_repo=(--exec omarchy-launch-tui lazygit -p "$REPO")

fail() {
  notify critical "Синхронизация форка: ошибка" "$1" "${open_repo[@]}"
  exit 1
}

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-upstream-sync.lock"
if ! flock -n 9; then
  echo "Another sync is running"
  exit 0
fi

cd "$REPO" || fail "Нет репозитория $REPO"

if [[ -f $(git rev-parse --git-path MERGE_HEAD) ]]; then
  notify normal "Синхронизация форка пропущена" "Незавершённый merge в $REPO: разреши конфликты и закоммить или сделай git merge --abort." "${open_repo[@]}"
  exit 0
fi

current=$(git symbolic-ref --short -q HEAD)
if [[ $current != "$BRANCH" ]]; then
  notify normal "Синхронизация форка пропущена" "Текущая ветка «${current:-detached HEAD}», а не $BRANCH." "${open_repo[@]}"
  exit 0
fi

if ! git diff --quiet || ! git diff --cached --quiet; then
  notify normal "Синхронизация форка пропущена" "В $REPO есть незакоммиченные изменения." "${open_repo[@]}"
  exit 0
fi

git fetch --quiet origin || fail "Не удалось получить origin (сеть или SSH-ключ)."
git fetch --quiet upstream || fail "Не удалось получить upstream (сеть?)."

# Bring the local branch up to date with the fork first.
if ! git merge-base --is-ancestor "origin/$BRANCH" HEAD; then
  if git merge-base --is-ancestor HEAD "origin/$BRANCH"; then
    git merge --quiet --ff-only "origin/$BRANCH" || fail "Не удалось перемотать $BRANCH до origin/$BRANCH."
  else
    fail "Локальный $BRANCH и origin/$BRANCH разошлись — нужно свести вручную."
  fi
fi

if git merge-base --is-ancestor "$UPSTREAM_REF" HEAD; then
  # Nothing new upstream; still publish local commits the fork lacks.
  if (( $(git rev-list --count "origin/$BRANCH..HEAD") > 0 )); then
    if git push --quiet origin "$BRANCH"; then
      notify low "Форк запушен" "Новых изменений в апстриме нет, локальные коммиты отправлены в origin."
    else
      fail "git push origin $BRANCH не прошёл."
    fi
  else
    echo "Up to date with $UPSTREAM_REF"
  fi
  exit 0
fi

new_commits=$(git rev-list --count --no-merges "HEAD..$UPSTREAM_REF")

if ! git merge --quiet --no-ff --no-edit -m "Merge $UPSTREAM_REF" "$UPSTREAM_REF"; then
  conflicts=$(git diff --name-only --diff-filter=U)
  if [[ -n $conflicts ]]; then
    count=$(wc -l <<<"$conflicts")
    list=$(head -5 <<<"$conflicts")
    (( count > 5 )) && list+=$'\n…'
    notify critical "Конфликт при merge апстрима" "Файлов с конфликтами: $count. Разреши их вручную и закоммить:"$'\n'"$list" "${open_repo[@]}"
    exit 1
  fi
  [[ -f $(git rev-parse --git-path MERGE_HEAD) ]] && git merge --abort
  fail "git merge $UPSTREAM_REF не прошёл (см. journalctl --user -u omarchy-upstream-sync)."
fi

if git push --quiet origin "$BRANCH"; then
  notify normal "Апстрим вмерджен и запушен" "Новых коммитов из $UPSTREAM_REF: $new_commits."
else
  fail "Merge сделан локально ($new_commits коммитов), но git push origin $BRANCH не прошёл."
fi

# The repo is the live OMARCHY_PATH, so new migrations may be waiting.
omarchy-migrate-notify || true
