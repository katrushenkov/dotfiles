#!/bin/bash

main_file="$HOME/.local/src/datagrip/bookmarks-web.txt"

get_existing_tags() {
	local file="$1"
	[ -f "$file" ] && cut -d'|' -f 3- "$file" | tr ' ' '\n' | grep -E '^#\w+$|^\w+$' | sort -u || true
}

text_input() {
	echo "" | tofi
}

add_bookmark() {
	local file="$1" url="$2" name="$3"

	if grep -q "^${url// /\\ } " "$file" 2>/dev/null; then
		notify-send "Oops" "Bookmark already exists"
		return 1
	fi

	local bookmarkline="$url | $name |"
	local tags="dummy"

	while [ -n "$tags" ]; do
		tags=$(get_existing_tags "$file" | omarchy-menu-select "add tags" -- --width 1400 --height 500 2>/dev/null || true)
		[ -z "$tags" ] && break
		bookmarkline+=" $tags"
	done

	echo "$bookmarkline" >> "$file"
	notify-send "✓ Bookmark Added" "$url"
}

search_and_open() {
	local file="$1" browser="${2:-vivaldi}"
	local selection

	selection=$(grep -v "^$" "$file" 2>/dev/null | \
		awk -F'|' '{printf "%-50s\t%-30s\t%s\n", $1, $2, $3}' | \
		omarchy-menu-select "Bookmark" -- --width 1792 --height 720 2>/dev/null | \
		cut -f 1 | xargs || true)

	[ -n "$selection" ] && "$browser" "$selection"
}

search_by_tag() {
	local file="$1" browser="${2:-vivaldi}"
	local tag

	# Get all unique tags in #tag format
	tag=$(grep -oh '#\w\+' "$file" | sort -u | sed 's/^#//' | \
		omarchy-menu-select "select tag" -- --width 1400 --height 600 2>/dev/null || true)

	if [ -z "$tag" ]; then
		return
	fi

	local result
	result=$(grep "#$tag" "$file" | \
		awk -F'|' '{printf "%-50s\t%-30s\t%s\n", $1, $2, $3}' | \
		omarchy-menu-select "tag: $tag" -- --width 1792 --height 720 2>/dev/null | \
		cut -f 1 | xargs || true)

	[ -n "$result" ] && "$browser" "$result"
}

case $1 in
	-a|--add)
		url=$(wl-paste)
		name=$(text_input "add name")
		[ -n "$name" ] && add_bookmark "$main_file" "$url" "$name"
		;;
	-s|--search)
		search_and_open "$main_file" "vivaldi"
		;;
	-st|--search-tag)
		search_by_tag "$main_file" "vivaldi"
		;;
	-am|--add-manual)
		url=$(text_input "add bookmark")
		[ -n "$url" ] && name=$(text_input "add name") && add_bookmark "$main_file" "$url" "$name"
		;;
	*)
		cat << EOF
Usage: bookmarks-web [option]

Options:
  -a, --add         Add from clipboard
  -s, --search      Search and open
  -st, --search-tag Search by tag and open
  -am, --add-manual Manually add bookmark
EOF
		;;
esac
