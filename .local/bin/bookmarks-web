#!/bin/bash

main_file="$HOME/.local/src/datagrip/bookmarks-web.txt"
browser="vivaldi"

hypr-switch-en

# tofi-dmenu opens on the focused monitor by itself (--output).
menu() { tofi-dmenu -p "$1: " -W "${2:-800}" -H "${3:-300}"; }
text_input() { tofi-dmenu -r -p "$1: " </dev/null; }

format_lines() { awk -F'|' 'NF {printf "%-50s %-30s %s\n", $1, $2, $3}'; }

pick_and_open() {
	local url
	url=$(format_lines | menu "$1" 1200 720 | awk '{print $1}')
	[ -n "$url" ] && "$browser" "$url"
}

add_bookmark() {
	local url="$1" name="$2" tags

	if grep -qF "$url " "$main_file" 2>/dev/null; then
		notify-send "Oops" "Bookmark already exists"
		return 1
	fi

	local line="$url | $name |"
	while tags=$(cut -d'|' -f3- "$main_file" 2>/dev/null | tr ' ' '\n' | grep -E '^#?\w+$' | sort -u | menu "add tags") && [ -n "$tags" ]; do
		line+=" $tags"
	done

	echo "$line" >> "$main_file"
	notify-send "✓ Bookmark Added" "$url"
}

case $1 in
	-a|--add)
		url=$(wl-paste)
		name=$(text_input "add name")
		[ -n "$name" ] && add_bookmark "$url" "$name"
		;;
	-am|--add-manual)
		url=$(text_input "add bookmark")
		[ -n "$url" ] && name=$(text_input "add name") && [ -n "$name" ] && add_bookmark "$url" "$name"
		;;
	-s|--search)
		pick_and_open "Bookmark" < "$main_file"
		;;
	-st|--search-tag)
		tag=$(grep -oh '#\w\+' "$main_file" | sort -u | sed 's/^#//' | menu "select tag")
		[ -n "$tag" ] && grep "#$tag\b" "$main_file" | pick_and_open "tag: $tag"
		;;
	*)
		cat << USAGE
Usage: bookmarks-web [option]

  -a,  --add         Add from clipboard
  -am, --add-manual  Manually add bookmark
  -s,  --search      Search and open
  -st, --search-tag  Search by tag and open
USAGE
		;;
esac
