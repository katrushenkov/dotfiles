#!/usr/bin/env bash
#
# Run an interactive picker (fzf, etc.) in a floating WezTerm popup, then copy
# its stdout to the clipboard and paste it into the window that was focused
# before the popup opened.
#
#   terminal-picker.sh ~/.local/bin/snippets-fzf
#   terminal-picker.sh --no-paste kubectl-ctx
#   terminal-picker.sh --no-restore bookmarks-web-mac -s
#   terminal-picker.sh --warm     # start the popup WezTerm ahead of time
#
# The target must print its result to stdout; its TUI must draw on /dev/tty
# (fzf, gum, fzy and friends all do this by default).

set -uo pipefail

# GUI launchers (Hammerspoon's `do shell script`, LaunchAgents) run us with
# launchd's bare PATH -- no path_helper, so no /opt/homebrew/bin.
PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

# fzf look and behaviour shared by every picker; targets add only their own
# flags (prompt, preview, --no-sort). Appended, so a user's own
# FZF_DEFAULT_OPTS is kept and these win where they overlap.
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--exact --cycle --reverse --info=inline --bind=ctrl-/:toggle-preview"

POPUP_CONFIG="${POPUP_CONFIG:-$HOME/.config/wezterm/popup.lua}"
PASTE_DELAY="${PASTE_DELAY:-0.15}"
do_paste=1
do_restore=1
clear_after=0
do_warm=0
last_clip=""

# stderr is discarded when launched from a GUI app, so also surface failures
# as a notification -- otherwise the popup just silently never appears.
notify() {
    osascript - "$1" >/dev/null 2>&1 <<'EOF'
on run argv
    display notification (item 1 of argv) with title "terminal-picker"
end run
EOF
}

die() {
    printf '%s: %s\n' "${0##*/}" "$1" >&2
    notify "$1"
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-paste) do_paste=0; shift ;;
        # For targets that act on the selection themselves (open a browser,
        # focus a window). Yanking focus back would steal it from whatever the
        # target just brought up.
        --no-restore) do_restore=0; do_paste=0; shift ;;
        # Put the old clipboard back after N seconds, so secrets don't linger.
        --clear-after)
            [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--clear-after needs seconds"
            clear_after="$2"; shift 2 ;;
        # Only make sure the popup WezTerm is running (Hammerspoon calls this
        # on load), so even the first picker skips the cold start.
        --warm) do_warm=1; shift ;;
        --) shift; break ;;
        -*) die "unknown option: $1" ;;
        *) break ;;
    esac
done

[[ -r "$POPUP_CONFIG" ]] || die "popup config not found: $POPUP_CONFIG"

# Resolve to the binary inside WezTerm.app. Launched through the Homebrew
# symlink, NSBundle can't find Info.plist, macOS reports no bundle identifier,
# and OmniWM's appRule for com.github.wez.wezterm never matches -- the popup
# gets tiled instead of floated.
WEZTERM_BIN="$(readlink -f -- "${WEZTERM_BIN:-$(command -v wezterm)}")" \
    || die "wezterm not found in PATH"
[[ -x "$WEZTERM_BIN" ]] || die "wezterm not executable: $WEZTERM_BIN"

# The popup WezTerm stays in memory between pickers (popup.lua sets
# quit_when_all_windows_are_closed = false): a new window in a running process
# opens in a few tens of ms, a cold start of WezTerm takes several hundred.
# Its GUI socket is how `wezterm cli` reaches that exact process, not whatever
# other WezTerm happens to be running.
DAEMON_PID_FILE="${TMPDIR:-/tmp}/terminal-picker.wezterm.pid"
daemon_sock() { printf '%s' "$HOME/.local/share/wezterm/gui-sock-$1"; }

# Prints the pid of the running popup WezTerm, fails if there is none.
daemon_pid() {
    local pid
    pid="$(cat "$DAEMON_PID_FILE" 2>/dev/null)" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
    # The pid may belong to something else by now.
    [[ "$(ps -o command= -p "$pid" 2>/dev/null)" == *"--config-file $POPUP_CONFIG "* ]] || return 1
    [[ -S "$(daemon_sock "$pid")" ]] || return 1
    printf '%s' "$pid"
}

# Cold start, with the given command as its first window. All of stdin,
# stdout and stderr detached: it outlives us, and hs.task must not wait on it.
start_daemon() {
    (cd "$HOME" && exec "$WEZTERM_BIN" --config-file "$POPUP_CONFIG" start \
        --always-new-process -- "$@" </dev/null >/dev/null 2>&1) &
    daemon=$!
    printf '%s' "$daemon" >"$DAEMON_PID_FILE"
}

if (( do_warm )); then
    daemon_pid >/dev/null || start_daemon /usr/bin/true
    exit 0
fi

[[ $# -gt 0 ]] || die "usage: ${0##*/} [--no-paste] <script> [args...]"

target="$1"; shift
if [[ "$target" != */* ]]; then
    target="$(command -v -- "$target")" || die "not found in PATH: $1"
fi
[[ -x "$target" ]] || die "not executable: $target"

# macOS doesn't let an app launched from the background (Hammerspoon's hs.task)
# take focus by itself: the popup shows up but keystrokes keep going to the old
# window. Wait for the popup's window and focus it explicitly.
focus_popup() {
    local pid="$1" id i
    for ((i = 0; i < 60; i++)); do
        # The target already finished, nothing left to focus.
        [[ -s "${status_file:-}" ]] && return 0
        if command -v omniwmctl >/dev/null 2>&1; then
            id="$(omniwmctl query windows --format json 2>/dev/null \
                | jq -r --argjson pid "$pid" \
                    'first(.result.payload.windows[] | select(.pid == $pid) | .id) // empty' 2>/dev/null)"
            [[ -n "$id" ]] && omniwmctl window focus "$id" >/dev/null 2>&1 && return 0
        elif osascript -e "tell application \"System Events\" to set frontmost of \
                (first application process whose unix id is $pid) to true" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.05
    done
}

# One popup at a time: a second hotkey press while a picker is open brings the
# open popup back to front instead of stacking another one on top of it.
lock_dir="${TMPDIR:-/tmp}/terminal-picker.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
    owner="$(cat "$lock_dir/pid" 2>/dev/null)"
    if [[ -n "$owner" ]] && kill -0 "$owner" 2>/dev/null; then
        popup="$(cat "$lock_dir/popup" 2>/dev/null)"
        [[ -n "$popup" ]] && kill -0 "$popup" 2>/dev/null && focus_popup "$popup"
        exit 0
    fi
    # No pid yet: the owner is between mkdir and writing it. Only a lock that
    # has stayed like that for a while is stale.
    if [[ -z "$owner" ]] && (( $(date +%s) - $(stat -f %m "$lock_dir" 2>/dev/null || echo 0) < 5 )); then
        exit 0
    fi
    rm -rf "$lock_dir"
    mkdir "$lock_dir" 2>/dev/null || exit 0
fi
printf '%s' "$$" >"$lock_dir/pid"

work_dir="$(mktemp -d "${TMPDIR:-/tmp}/terminal-picker.XXXXXX")"
trap 'rm -rf "$work_dir" "$lock_dir"' EXIT
result_file="$work_dir/result"
err_file="$work_dir/stderr"
status_file="$work_dir/status"

# Remember the focused window to come back to. OmniWM (this box's tiling WM)
# answers instantly and is exact: it can stack several windows of the same app
# in one tabbed column, and they all report the same pid/position to System
# Events. The System Events query costs 100-200 ms, so it only runs without
# OmniWM's IPC (omniwmctl, ~/.config/omniwm/settings.toml ipcEnabled).
prev_omni_id="" prev_pid="" prev_win_x="" prev_win_y=""
if command -v omniwmctl >/dev/null 2>&1; then
    read -r prev_omni_id prev_pid prev_win_x prev_win_y <<<"$(
        omniwmctl query focused-window --format json 2>/dev/null \
            | jq -r '.result.payload.window // empty
                     | "\(.id) \(.pid) \(.frame.x // -1) \(.frame.y // -1)"' 2>/dev/null)"
fi
if [[ -z "$prev_omni_id" ]]; then
    read -r prev_pid prev_win_x prev_win_y <<<"$(osascript <<'EOF'
tell application "System Events"
    set p to first application process whose frontmost is true
    set winPos to {-1, -1}
    -- System Events windows have no stable id, so pin down *which* window of
    -- the process was frontmost by position -- restoring by pid/app alone
    -- lets macOS pick any window of that app (wrong one when e.g. several
    -- Kitty/WezTerm windows are open across spaces).
    try
        set winPos to position of front window of p
    end try
    return ((unix id of p) as text) & " " & (item 1 of winPos) & " " & (item 2 of winPos)
end tell
EOF
)"
fi

# POSIX single-quoting, so the command is parsed the same by bash and zsh.
quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# Run through the login shell, not a hardcoded bash: exports live in the user's
# own startup files (~/.zprofile here) and scripts expect the same environment
# they get in a terminal. GUI launchers give us none of it.
# stderr and the exit status go to files too: the popup closes as soon as the
# target exits, so its error message would otherwise never be seen.
# A window spawned into the running popup WezTerm inherits *its* environment,
# not ours, so pass FZF_DEFAULT_OPTS along explicitly.
inner="export FZF_DEFAULT_OPTS=$(quote "$FZF_DEFAULT_OPTS"); "
for arg in "$target" "$@"; do
    inner+="$(quote "$arg") "
done
inner+="> $(quote "$result_file") 2> $(quote "$err_file"); echo \$? > $(quote "$status_file")"

# There is no process of our own to `wait` on any more: the popup is a window
# of the shared WezTerm. Wait for its pane to show up and go away again (the
# target exited, or the window was closed by hand).
wait_popup() {
    local sock n i seen=0
    sock="$(daemon_sock "$daemon")"
    for ((i = 0; ; i++)); do
        kill -0 "$daemon" 2>/dev/null || return 0
        n="$(WEZTERM_UNIX_SOCKET="$sock" "$WEZTERM_BIN" cli --no-auto-start list --format json 2>/dev/null \
            | jq length 2>/dev/null)"
        if [[ "$n" =~ ^[0-9]+$ ]]; then
            if (( n > 0 )); then
                seen=1
            # A target that exits at once is gone before the first poll sees
            # its pane; the status file says it did run.
            elif (( seen )) || [[ -s "$status_file" ]]; then
                return 0
            fi
        fi
        # Never showed up within ~10 s: the spawn failed.
        (( seen || i < 200 )) || return 0
        sleep 0.05
    done
}

# fzf writes its UI to /dev/tty, so redirecting stdout keeps the popup usable.
popup_cmd=("${SHELL:-/bin/bash}" -lc "$inner")
if daemon="$(daemon_pid)"; then
    WEZTERM_UNIX_SOCKET="$(daemon_sock "$daemon")" "$WEZTERM_BIN" cli --no-auto-start \
        spawn --new-window --cwd "$HOME" -- "${popup_cmd[@]}" >/dev/null 2>&1 || daemon=""
fi
[[ -n "$daemon" ]] || start_daemon "${popup_cmd[@]}"
printf '%s' "$daemon" >"$lock_dir/popup"
focus_popup "$daemon"
wait_popup

result="$(< "$result_file")"
status="$(cat "$status_file" 2>/dev/null)"

# "force": even with --no-restore. The popup WezTerm stays running with no
# windows left, and macOS keeps it frontmost -- keystrokes would go nowhere.
# Only a target that brought up an app of its own may skip this.
restore_focus() {
    (( do_restore )) || [[ "${1:-}" == force ]] || return 0
    if [[ -n "$prev_omni_id" ]] && omniwmctl window focus "$prev_omni_id" >/dev/null 2>&1; then
        return 0
    fi
    [[ -n "${prev_pid:-}" ]] || return 0
    osascript - "$prev_pid" "${prev_win_x:--1}" "${prev_win_y:--1}" >/dev/null 2>&1 <<'EOF'
on run argv
    set targetPid to (item 1 of argv) as integer
    set targetX to (item 2 of argv) as integer
    set targetY to (item 3 of argv) as integer
    tell application "System Events"
        set procs to (every application process whose unix id is targetPid)
        if (count of procs) > 0 then
            set proc to item 1 of procs
            set frontmost of proc to true
            if targetX is not -1 then
                try
                    set focused of (first window of proc whose position is {targetX, targetY}) to true
                end try
            end if
        end if
    end tell
end run
EOF
}

# Empty status: the popup was closed by hand. 130 is Esc/Ctrl-C in fzf, and
# a bare 1 with nothing on stderr is fzf's "no match" -- both are a cancel.
if [[ -n "$status" && "$status" != 0 && "$status" != 130 ]]; then
    err="$(sed $'s/\x1b\\[[0-9;]*[a-zA-Z]//g' "$err_file" 2>/dev/null \
        | grep -v '^[[:space:]]*$' | tail -n 3)"
    if [[ -n "$err" || "$status" != 1 ]]; then
        restore_focus force
        notify "${err:-${target##*/} exited with status $status}"
        exit 1
    fi
fi

[[ -n "$result" ]] || { restore_focus force; exit 0; }

# A target that wants the selection opened rather than pasted emits
# "#!open <path>": open it and leave focus with whatever app it brings up.
if [[ "$result" == "#!open "* ]]; then
    open -- "${result#"#!open "}"
    exit 0
fi

send_paste() {
    sleep "$PASTE_DELAY"
    # key code 9 is V; `keystroke "v"` looks the letter up in the active
    # layout and sends nothing (or the wrong key) under Russian.
    osascript -e 'tell application "System Events" to key code 9 using command down' \
        >/dev/null 2>&1
}

# Key codes rather than AppleScript key constants -- they don't depend on the
# active keyboard layout.
send_key() {
    local code
    case "$1" in
        tab)          code=48 ;;
        return|enter) code=36 ;;
        space)        code=49 ;;
        *)            return 0 ;;
    esac
    osascript -e "tell application \"System Events\" to key code $code" >/dev/null 2>&1
}

# A target that needs more than one paste (username <Tab> password) emits an
# action script instead of a bare value: "#!autotype" followed by one command
# per line. Values are base64 so they survive newlines and quoting untouched.
#
#   paste <base64>   put it on the clipboard and press cmd+V
#   key tab|return|space
#   delay <seconds>
play_autotype() {
    local line cmd arg
    while IFS= read -r line; do
        cmd="${line%% *}"
        arg="${line#* }"
        [[ "$arg" == "$line" ]] && arg=""
        case "$cmd" in
            paste)
                last_clip="$(printf '%s' "$arg" | base64 -d)"
                printf '%s' "$last_clip" | pbcopy
                send_paste
                ;;
            key)   send_key "$arg" ;;
            delay) sleep "$arg" ;;
        esac
    done < <(printf '%s\n' "$result" | tail -n +2)
}

(( clear_after )) && previous_clip="$(pbpaste)"

if [[ "${result%%$'\n'*}" == "#!autotype" ]]; then
    restore_focus
    play_autotype
else
    last_clip="$result"
    printf '%s' "$result" | pbcopy
    restore_focus
    (( do_paste )) && send_paste
fi

# Held in the subshell's memory, never on disk, and it outlives us. Only put the
# old clipboard back if ours is still there -- otherwise we'd clobber whatever
# the user copied in the meantime.
if (( clear_after )); then
    (
        trap '' HUP
        sleep "$clear_after"
        [[ "$(pbpaste)" == "$last_clip" ]] && printf '%s' "$previous_clip" | pbcopy
    ) >/dev/null 2>&1 &
fi
